# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (Loaded during: `npm run build` or `vite build`)
# Used for live deployment with real cloud APIs and disabled debug banners
# ==============================================================================

VITE_APP_ENV=production
VITE_API_BASE_URL=https://api.cloudservices-production.com/v1
VITE_DEBUG_MODE=false
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_ANALYTICS=true
VITE_ITEMS_PER_PAGE=25
VITE_TIMEOUT_MS=3000
VITE_ENVIRONMENT_BADGE="PRODUCTION (Live Cloud)"
VITE_BADGE_COLOR="purple"
